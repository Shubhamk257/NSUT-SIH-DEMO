<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIH 2026 — Environmental Intelligence Network</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <style>
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.4); opacity: 0; }
            100% { transform: scale(0.95); opacity: 0; }
        }
        .pulse-danger { animation: pulse-ring 1.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite; }
        #map { height: 340px; border-radius: 0.75rem; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen p-6">

    <header class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center pb-6 border-b border-slate-800 gap-4">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-block w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs font-mono tracking-widest text-emerald-400 uppercase">System Active • Edge Intelligence Online</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-white mt-1">Environmental Early Warning Network</h1>
            <p class="text-sm text-slate-400">Autonomous hazard telemetry & on-device TinyML inference node</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs font-mono bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-md text-slate-300">
                Node ID: <strong class="text-white">AUTO-IP-NODE-01</strong>
            </span>
            <span id="lastUpdated" class="text-xs font-mono text-slate-500">Syncing...</span>
        </div>
    </header>

    <div class="max-w-7xl mx-auto mt-6">
        <div id="statusBanner" class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between transition-all duration-300">
            <div class="flex items-center gap-4">
                <div id="statusIconBg" class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-xl">🌿</div>
                <div>
                    <h3 id="statusTitle" class="font-semibold text-white">Edge AI Status: Nominal</h3>
                    <p id="statusDesc" class="text-xs text-slate-400">Microcontroller neural net reports baseline parameters.</p>
                </div>
            </div>
            <span id="threatBadge" class="text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider bg-emerald-950 text-emerald-300 border border-emerald-800">Level 0 • Safe</span>
        </div>
    </div>

    <main class="max-w-7xl mx-auto mt-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="space-y-6">
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl">
                    <span class="text-xs text-slate-400 font-medium uppercase tracking-wider">Surface Temp</span>
                    <div class="mt-2 flex items-baseline gap-1">
                        <span id="cardTemp" class="text-3xl font-extrabold text-white">--</span>
                        <span class="text-sm font-semibold text-slate-500">°C</span>
                    </div>
                </div>
                <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl">
                    <span class="text-xs text-slate-400 font-medium uppercase tracking-wider">Smoke Index</span>
                    <div class="mt-2 flex items-baseline gap-1">
                        <span id="cardSmoke" class="text-3xl font-extrabold text-white">--</span>
                        <span class="text-sm font-semibold text-slate-500">ppm</span>
                    </div>
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl">
                <div class="flex justify-between items-center mb-3">
                    <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-400">Node Geospatial Deployment</h4>
                    <span id="gpsCoords" class="text-[10px] font-mono text-slate-500">Acquiring Lock...</span>
                </div>
                <div id="map"></div>
            </div>
        </div>

        <div class="lg:col-span-2 bg-slate-900 border border-slate-800 p-5 rounded-xl flex flex-col justify-between">
            <div>
                <div class="h-[320px] w-full">
                    <canvas id="telemetryChart"></canvas>
                </div>
            </div>
        </div>
    </main>

    <script>
        const supabaseUrl = 'PASTE_YOUR_PROJECT_URL_HERE';
        const supabaseKey = 'PASTE_YOUR_API_KEY_HERE';
        const db = supabase.createClient(supabaseUrl, supabaseKey);

        // Map setup (Starts hidden/default until data arrives)
        let mapInitialized = false;
        let map, marker;
        const defaultLocation = [28.6091, 77.0411]; // Fallback to NSUT Campus if IP fails

        function initMap(lat, lng) {
            map = L.map('map', { zoomControl: false }).setView([lat, lng], 14);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png').addTo(map);
            marker = L.circleMarker([lat, lng], { radius: 8, color: '#10b981', fillColor: '#10b981', fillOpacity: 0.9, weight: 2 }).addTo(map);
            mapInitialized = true;
        }

        let chartInstance = null;
        const ctx = document.getElementById('telemetryChart').getContext('2d');
        chartInstance = new Chart(ctx, {
            type: 'line',
            data: { labels: [], datasets: [
                { label: 'Temp', data: [], borderColor: '#f43f5e', yAxisID: 'y' },
                { label: 'Smoke', data: [], borderColor: '#22d3ee', yAxisID: 'y1' }
            ]},
            options: { animation: false }
        });

        async function updateDashboard() {
            const { data, error } = await db.from('sensor_data').select('*').order('created_at', { ascending: false }).limit(20);
            if (error || !data || data.length === 0) return;

            data.reverse(); 
            const latest = data[data.length - 1];

            // Update Cards
            document.getElementById('cardTemp').innerText = latest.temperature || '--';
            document.getElementById('cardSmoke').innerText = latest.smoke_level || '--';
            document.getElementById('lastUpdated').innerText = 'Last reading: ' + new Date(latest.created_at).toLocaleTimeString();

            // Handle Map & Location
            const nodeLat = latest.lat || defaultLocation[0];
            const nodeLng = latest.lng || defaultLocation[1];
            
            if (!mapInitialized) {
                initMap(nodeLat, nodeLng);
            } else {
                marker.setLatLng([nodeLat, nodeLng]);
                map.setView([nodeLat, nodeLng]);
            }
            document.getElementById('gpsCoords').innerText = `GPS: ${nodeLat.toFixed(4)}° N, ${nodeLng.toFixed(4)}° E`;

            // Update UI Colors
            const isAlert = latest.ai_alert === true;
            if (isAlert) {
                document.getElementById('statusBanner').className = "bg-rose-950/40 border border-rose-500/50 rounded-xl p-4 flex items-center justify-between";
                document.getElementById('statusTitle').innerText = "CRITICAL HAZARD: Wildfire Incursion Detected";
                marker.setStyle({ color: '#f43f5e', fillColor: '#f43f5e' });
            } else {
                document.getElementById('statusBanner').className = "bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-center justify-between";
                document.getElementById('statusTitle').innerText = "Edge AI Status: Nominal";
                marker.setStyle({ color: '#10b981', fillColor: '#10b981' });
            }

            // Update Chart
            chartInstance.data.labels = data.map(r => new Date(r.created_at).toLocaleTimeString());
            chartInstance.data.datasets[0].data = data.map(r => r.temperature || 0);
            chartInstance.data.datasets[1].data = data.map(r => r.smoke_level || 0);
            chartInstance.update();
        }

        updateDashboard();
        setInterval(updateDashboard, 3000);
    </script>
</body>
</html>
